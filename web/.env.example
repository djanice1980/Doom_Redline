# Copy to .env.local for local runs; set the same names in the Vercel project settings.
DATABASE_URL=postgres://postgres:redline@localhost:55432/redline   # Supabase: Settings > Database > Connection string, "Transaction" pooler (port 6543)
EMAIL_HMAC_KEY=change-me-to-a-long-random-string                    # blind index of email addresses
DATA_KEY=                                                          # 32 bytes, base64 or hex: `openssl rand -base64 32`
ADMIN_PASSWORD=change-me                                           # HTTP Basic password for /admin
CRON_SECRET=change-me                                              # Vercel sends it to /api/cron/ratings
SITE_URL=https://your-project.vercel.app                            # used in emails
MAIL_MODE=log                                                      # log = write mails to the log table instead of sending; graph = send through Microsoft Graph
# Optional: Graph credentials here instead of the admin page
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
