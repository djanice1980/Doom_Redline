# Maintainer: David Janice
# Builds REDLINE from the checked-out source tree two levels up
# (run `makepkg -si` inside packaging/arch). No Doom data is included: the
# game asks for doom.wad on first launch, or set REDLINE_WAD / ~/.local/share/redline/redline/wad.txt.
pkgname=redline
pkgver=0.1.0
pkgrel=1
pkgdesc="Tetris that tips over into a Doom fight (Vulkan, SDL3; needs your own doom.wad)"
arch=('x86_64')
url="https://github.com/djanice1980/redline"
license=('MIT')
depends=('sdl3' 'vulkan-icd-loader' 'libvorbis' 'hicolor-icon-theme')
optdepends=('fluidsynth: soundfont music backend' 'zenity: file browser for choosing the WAD outside KDE')
makedepends=('cmake' 'ninja' 'glm' 'vulkan-headers' 'shaderc' 'pkgconf')
options=('!debug')

_srcdir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../.." && pwd)"

build() {
  cmake -S "$_srcdir" -B "$srcdir/build" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DREDLINE_BUILD_TESTS=OFF
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
